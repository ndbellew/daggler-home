
odysseus.{$DAGGLER_DOMAIN} {
    tls internal
    reverse_proxy 192.168.4.35:7000
}

grafana.{$DAGGLER_DOMAIN} {
    tls internal
    reverse_proxy {$GRAFANA_HOST}:{$GRAFANA_PORT}
}

prometheus.{$DAGGLER_DOMAIN} {
    tls internal
    reverse_proxy {$PROMETHEUS_HOST}:{$PROMETHEUS_PORT}
}

portainer.{$DAGGLER_DOMAIN} {
    tls internal

    reverse_proxy https://portainer:9443  {
        transport http {
            tls_insecure_skip_verify
        }
    }
}

pihole.{$DAGGLER_DOMAIN} {
    tls internal
    reverse_proxy pihole:80/admin/login
}


wazuh.{$DAGGLER_DOMAIN} {
    tls internal

    reverse_proxy https://192.168.4.40:443 {
        transport http {
            tls_insecure_skip_verify
        }
    }
}

openclaw.{$DAGGLER_DOMAIN} {
    tls internal
    reverse_proxy http://{$OPENCLAW_HOST}:{$OPENCLAW_PORT}
}